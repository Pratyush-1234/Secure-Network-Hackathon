# =====================================================================
# Shield Wall: nginx reverse proxy + ModSecurity v3 + OWASP CRS v4
# This file replaces the image's /etc/nginx/templates/conf.d/default.conf.template.
# Rendered by envsubst at start-up. Only ${VARS} defined in the container
# environment get substituted; nginx $variables (lower-case) pass through unchanged.
# =====================================================================

server_tokens off;
more_set_headers 'Server: shieldwall';

# Correlate nginx access-log lines with ModSecurity audit-log entries
modsecurity_transaction_id "$request_id";

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ---------------------------------------------------------------------
# Rate limiting (T1110 Brute Force)
#   general : every request, per client IP, protects against floods
#   login   : only POST /login.php (the real DVWA login form)
#   brute   : only /vulnerabilities/brute/ requests carrying ?Login=
# An empty key means nginx does not account the request in that zone.
# ---------------------------------------------------------------------
map $request_method $login_limit_key {
    POST    $binary_remote_addr;
    default "";
}
map $arg_Login $brute_limit_key {
    ""      "";
    default $binary_remote_addr;
}

limit_req_zone $binary_remote_addr zone=general:10m rate=20r/s;
limit_req_zone $login_limit_key    zone=login:10m   rate=6r/m;
limit_req_zone $brute_limit_key    zone=brute:10m   rate=6r/m;
limit_conn_zone $binary_remote_addr zone=perip:10m;

limit_req_status  429;
limit_conn_status 429;
limit_req_log_level  error;   # "limiting requests ... by zone" lines feed fail2ban

upstream dvwa_backend {
    server ${BACKEND_HOSTPORT};
    keepalive 16;
}

# ---------------------------------------------------------------------
# HTTP: health check plus a permanent redirect to HTTPS, nothing else
# ---------------------------------------------------------------------
server {
    listen ${PORT} default_server;
    server_name ${SERVER_NAME};

    location = /healthz {
        access_log off;
        modsecurity off;
        default_type text/plain;
        return 200 "OK\n";
    }

    location / {
        return 301 https://$host:${PUBLIC_HTTPS_PORT}$request_uri;
    }
}

# ---------------------------------------------------------------------
# HTTPS: TLS termination, WAF inspection, then proxy to the legacy app
# ---------------------------------------------------------------------
server {
    listen ${SSL_PORT} ssl default_server;
    server_name ${SERVER_NAME};

    ssl_certificate     ${SSL_CERT_FILE};
    ssl_certificate_key ${SSL_CERT_KEY_FILE};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_ecdh_curve      X25519:prime256v1:secp384r1;
    ssl_session_timeout 1d;
    ssl_session_cache   shared:TLS:10m;
    ssl_session_tickets off;

    # Security headers on every response, including WAF 403s and 429s
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "SAMEORIGIN" always;
    add_header Referrer-Policy           "same-origin" always;
    add_header X-Request-ID              $request_id always;
    add_header Permissions-Policy        "camera=(), microphone=(), geolocation=(), payment=()" always;

    client_max_body_size 1m;
    limit_conn perip 20;
    limit_req  zone=general burst=40 nodelay;

    location = /healthz {
        access_log off;
        modsecurity off;
        default_type text/plain;
        return 200 "OK\n";
    }

    # Login form: strict rate limit on credential submissions
    location = /login.php {
        limit_req zone=general burst=40 nodelay;
        limit_req zone=login   burst=3  nodelay;
        include /etc/nginx/shieldwall/shieldwall_proxy.conf;
    }

    # DVWA's brute-force exercise (a second login surface)
    location ^~ /vulnerabilities/brute/ {
        limit_req zone=general burst=40 nodelay;
        limit_req zone=brute   burst=3  nodelay;
        include /etc/nginx/shieldwall/shieldwall_proxy.conf;
    }

    # Never expose the DB reset page or phpinfo through the edge
    location ~* ^/(setup\.php|phpinfo\.php|\.git|\.env|config/|database/|docs/|tests/) {
        return 404;
    }

    location / {
        include /etc/nginx/shieldwall/shieldwall_proxy.conf;
    }
}
