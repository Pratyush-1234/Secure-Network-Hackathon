# Structured JSON access log, shipped by Vector to the central log store.
# Replaces the image's conf.d/logging.conf.template.
log_format shieldwall_json escape=json
  '{"ts":"$time_iso8601",'
  '"request_id":"$request_id",'
  '"client_ip":"$remote_addr",'
  '"method":"$request_method",'
  '"uri":"$request_uri",'
  '"protocol":"$server_protocol",'
  '"status":$status,'
  '"bytes_sent":$body_bytes_sent,'
  '"request_time":$request_time,'
  '"upstream_status":"$upstream_status",'
  '"limit_req":"$limit_req_status",'
  '"tls":"$ssl_protocol",'
  '"host":"$host",'
  '"referer":"$http_referer",'
  '"user_agent":"$http_user_agent"}';

access_log ${ACCESSLOG} shieldwall_json;
error_log  ${ERRORLOG} ${LOGLEVEL};
